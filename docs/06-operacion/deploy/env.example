# /etc/paqgateway/env — plantilla (NO commitear valores reales)
# sudo install -d -m 750 -o root -g paqgateway /etc/paqgateway
# sudo cp env.example /etc/paqgateway/env && sudo chmod 640 /etc/paqgateway/env
# Generar keys fuertes; guardar en 1Password / Secrets Manager.

ASPNETCORE_ENVIRONMENT=Production
# 0.0.0.0: Laravel (otra EC2 en la VPC) alcanza :5100; el SG limita el origen.
# 127.0.0.1 solo alcanza desde la misma máquina (Nginx local OK; Forge NO).
ASPNETCORE_URLS=http://0.0.0.0:5100

# Obligatorio — Laravel → Gateway (header X-Paq-Internal-Api-Key)
Gateway__InternalApiKey=

# Obligatorio — Gateway → Laravel auth agentes (URL PRIVADA VPC)
LaravelApi__BaseUrl=http://10.x.x.x
LaravelApi__InternalApiKey=

# Prohibido en producción (N5)
Gateway__UseDevAuthStub=false

# Opcional
# Gateway__AgentTokenCacheSeconds=60
# Gateway__OnlineTtlSeconds=90
