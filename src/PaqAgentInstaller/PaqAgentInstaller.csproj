<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AgentPayloadZip Condition="'$(AgentPayloadZip)' == ''">$(MSBuildThisFileDirectory)Resources\agent-payload.zip</AgentPayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(AgentPayloadZip)" Condition="Exists('$(AgentPayloadZip)')">
      <LogicalName>PaqAgentInstaller.agent-payload.zip</LogicalName>
      <Link>Resources\agent-payload.zip</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
